# ==========================================
# AURA RAP STUDIO - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port & URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (SQLite default for zero-friction setup, PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# For PostgreSQL / Neon Database (uncomment to use):
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Audio Storage Directory
AUDIO_STORAGE_PATH="./public/uploads"

# ------------------------------------------
# AI PROVIDERS (Configure your preferred API keys)
# The studio includes built-in procedural Hip-Hop audio generators,
# rap flow algorithms, and Web Audio DSP that function without external keys.
# Adding external keys enables 3rd-party generative cloud models.
# ------------------------------------------

# AI Beat Generation (Replicate / MusicGen / Suno / ElevenLabs API)
AI_BEAT_PROVIDER="builtin" # "builtin" | "replicate" | "elevenlabs" | "suno"
REPLICATE_API_TOKEN=""
ELEVENLABS_API_KEY=""

# AI Vocal Analysis & Music Assistant (OpenAI / Anthropic / Gemini API)
AI_LLM_PROVIDER="gemini" # "gemini" | "openai" | "anthropic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# AI Stem Separation / Demucs Endpoint (Optional)
DEMUCS_WORKER_URL=""
