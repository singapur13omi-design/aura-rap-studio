datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String         @id @default(uuid())
  name                   String?
  email                  String         @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   String         @default("USER") // USER, ADMIN, OWNER
  plan                   String         @default("FREE_TRIAL") // FREE_TRIAL, MONTHLY_PASS, ANNUAL_PASS, OWNER
  subscriptionStatus     String         @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELED, EXPIRED
  trialEndsAt            DateTime?
  aiUsageCount           Int            @default(0)
  hasVideoAccess         Boolean        @default(false)
  videoCredits           Int            @default(0)
  stripeCustomerId       String?        @unique
  stripeSubscriptionId   String?        @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  accounts               Account[]
  sessions               Session[]
  projects               Project[]
  voiceProfiles          VoiceProfile[]
  vipRedemptions         VipRedemption[]
  videoProjects          VideoProject[]
  videoJobs              VideoGenerationJob[]
  videoCreditTxs         VideoCreditTransaction[]
  ownedCollabs           Collaboration[]             @relation("CollaborationOwner")
  collabMemberships      CollaborationMember[]
  collabInvitesSent      CollaborationInvite[]       @relation("CollaborationInvitesSent")
  collabTracksUploaded   CollaborationTrack[]
  collabComments         CollaborationComment[]
  collabSplits           CollaborationCreditSplit[]
  collabNotificationsRec CollaborationNotification[] @relation("NotificationRecipient")
  collabNotificationsSnt CollaborationNotification[] @relation("NotificationSender")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String           @id @default(uuid())
  title           String           @default("Untitled Rap Project")
  language        String           @default("sk")
  genre           String           @default("TRAP")
  bpm             Int              @default(140)
  keyScale        String           @default("C Minor")
  projectType     String           @default("RECORD_VOICE") // RECORD_VOICE, UPLOAD_RAP, FROM_EXISTING, START_BEAT
  status          String           @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ARCHIVED
  duration        Float            @default(0)
  masterVolume    Float            @default(1.0)
  metronomeOn     Boolean          @default(false)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tracks          AudioTrack[]
  versions        ProjectVersion[]
  analyses        AIAnalysis[]
  exportJobs      ExportJob[]
  processingJobs  ProcessingJob[]
  collaboration   Collaboration?
}

model AudioTrack {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  layerType    String        @default("MAIN_VOCAL") // MAIN_VOCAL, DOUBLE_VOCAL, AD_LIBS, BACKING, CHORUS, HARMONIES, INTRO, OUTRO, BEAT, INSTRUMENTAL
  color        String        @default("#00E5FF")
  volume       Float         @default(0.8)
  pan          Float         @default(0.0) // -1.0 to 1.0
  muted        Boolean       @default(false)
  soloed       Boolean       @default(false)
  startTime    Float         @default(0.0) // timeline offset in seconds
  duration     Float         @default(0.0)
  orderIndex   Int           @default(0)
  assetUrl     String?       // reference to audio file
  storageType  String?       @default("LOCAL") // 'VERCEL_BLOB' | 'POSTGRES_BYTEA' | 'LOCAL'
  fileSize     Int?          // in bytes
  mimeType     String?       // 'audio/wav', 'audio/webm', 'audio/mpeg'
  audioChecksum String?      // SHA-256 hash for integrity verification
  waveformData String?       // JSON array of peaks for waveform preview
  effects      String?       // JSON of FX chain: { eq: {...}, comp: {...}, reverb: {...}, delay: {...}, autotune: {...} }
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  audioBlob    AudioTrackBlob?
}

model AudioTrackBlob {
  id           String     @id @default(uuid())
  trackId      String     @unique
  track        AudioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mimeType     String     @default("audio/wav")
  size         Int        @default(0)
  data         Bytes
  checksum     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Beat {
  id           String   @id @default(uuid())
  title        String
  genre        String   // TRAP, DRILL, DARK_TRAP, BOOM_BAP, MELODIC_RAP, etc.
  bpm          Int
  keyScale     String
  audioUrl     String
  previewUrl   String?
  duration     Float
  source       String   @default("BUILT_IN") // BUILT_IN, AI_GENERATED, IMPORTED
  license      String   @default("Royalty Free - Aura Rap Studio")
  tags         String?  // comma-separated tags
  createdAt    DateTime @default(now())
}

model BeatGenerationJob {
  id          String   @id @default(uuid())
  prompt      String
  genre       String
  bpm         Int
  keyScale    String?
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0)
  audioUrl    String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIAnalysis {
  id                   String   @id @default(uuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimatedBpm         Int
  flowStyle            String   // Aggressive, Laid-back, Melodic, Fast Cadence, Triplet
  energy               String   // High, Medium, Low
  vocalCharacter       String   // Deep, Bright, Gritty, Smooth
  keyScale             String?
  detectedKey          String?
  chorusLocations      String?  // JSON array of timestamp intervals
  adlibLocations       String?  // JSON array of timestamp intervals
  styleRecommendation  String?
  beatRecommendation   String?
  rawAnalysisJson      String?
  createdAt            DateTime @default(now())
}

model VoiceProfile {
  id                 String   @id @default(uuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  character          String   // e.g. "Gritty Street", "Melodic Autotuned", "Crisp Boom-Bap"
  preferredGenre     String   @default("TRAP")
  preferredFxChain   String?  // JSON
  referenceAudioUrl  String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionName String
  snapshot    String   // Full JSON snapshot of project state
  createdAt   DateTime @default(now())
}

model ProcessingJob {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // AI_MIX, AI_MASTER, AUTOTUNE, VOCAL_CLEAN, STEM_SEPARATE
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0)
  stepName    String?  // e.g. "ANALYZING TRACK", "CLEANING VOCALS", "PROCESSING LAYERS"
  parameters  String?  // JSON
  result      String?  // JSON
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExportJob {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format        String   // WAV, MP3
  bitDepth      Int      @default(24) // 16, 24, 32
  sampleRate    Int      @default(44100) // 44100, 48000
  includeStems  Boolean  @default(false)
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  downloadUrl   String?
  fileSizeBytes Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VipCode {
  id           String          @id @default(uuid())
  code         String          @unique
  label        String
  durationDays Int             @default(30)
  maxUses      Int             @default(1)
  timesUsed    Int             @default(0)
  isRevoked    Boolean         @default(false)
  isContest    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  redemptions  VipRedemption[]
}

model VipRedemption {
  id         String   @id @default(uuid())
  codeId     String
  vipCode    VipCode  @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail  String
  redeemedAt DateTime @default(now())

  @@unique([codeId, userId])
}

model ContestSubmission {
  id          String   @id @default(uuid())
  userId      String?
  artistName  String
  email       String
  trackTitle  String
  audioUrl    String?
  socialLink  String?
  notes       String?
  createdAt   DateTime @default(now())
}

model VideoProject {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String            @default("Untitled Music Video")
  artistName      String?
  songTitle       String?
  lyrics          String?           @db.Text
  visualStyle     String            @default("DARK_TRAP")
  aspectRatio     String            @default("16:9")
  fps             Int               @default(30)
  resolution      String            @default("1080p")
  duration        Float             @default(0.0)
  audioTrackUrl   String?
  audioProjectId  String?
  timelineData    String?           @db.Text
  status          String            @default("DRAFT")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  scenes          VideoScene[]
  assets          VideoAsset[]
  exports         VideoExport[]
}

model VideoScene {
  id              String        @id @default(uuid())
  projectId       String
  project         VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneIndex      Int
  title           String
  sectionType     String
  startTime       Float
  endTime         Float
  duration        Float
  visualPrompt    String        @db.Text
  negativePrompt  String?       @db.Text
  cameraMovement  String?
  lightingStyle   String?
  status          String        @default("PLANNED")
  activeVideoUrl  String?
  generatedVideos VideoAsset[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model VideoAsset {
  id              String        @id @default(uuid())
  projectId       String
  project         VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId         String?
  scene           VideoScene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  type            String        // AI_GENERATED, USER_UPLOAD, ENHANCED
  sourceModel     String?
  storageUrl      String
  thumbnailUrl    String?
  duration        Float         @default(5.0)
  resolution      String?
  width           Int?
  height          Int?
  fileSizeBytes   BigInt?
  promptUsed      String?       @db.Text
  generationCost  Int?
  createdAt       DateTime      @default(now())
}

model VideoGenerationJob {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  sceneId         String?
  provider        String        @default("FAL_AI")
  externalJobId   String?
  jobType         String        @default("TEXT_TO_VIDEO")
  prompt          String        @db.Text
  status          String        @default("PENDING")
  progress        Int           @default(0)
  creditsDeducted Int           @default(0)
  resultVideoUrl  String?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model VideoCreditTransaction {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  balanceAfter    Int
  reason          String
  referenceId     String?
  createdAt       DateTime      @default(now())
}

model VideoExport {
  id              String        @id @default(uuid())
  projectId       String
  project         VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format          String        @default("MP4")
  resolution      String        @default("1080p")
  fps             Int           @default(30)
  aspectRatio     String        @default("16:9")
  fileSizeBytes   BigInt?
  downloadUrl     String
  status          String        @default("COMPLETED")
  createdAt       DateTime      @default(now())
}

// ==========================================
// AURA COLLAB MODELS
// ==========================================

model Collaboration {
  id              String                  @id @default(uuid())
  projectId       String                  @unique
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String                  // Song Title
  ownerId         String                  // User ID of project owner
  owner           User                    @relation("CollaborationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status          String                  @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED, CANCELLED
  terms           String?                 @db.Text // Agreed notes & production terms
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  members         CollaborationMember[]
  invites         CollaborationInvite[]
  tracks          CollaborationTrack[]
  comments        CollaborationComment[]
  splits          CollaborationCreditSplit[]
  notifications   CollaborationNotification[]
}

model CollaborationMember {
  id              String        @id @default(uuid())
  collabId        String
  collab          Collaboration @relation(fields: [collabId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String        @default("FEATURE_ARTIST") // OWNER, FEATURE_ARTIST, PRODUCER, SOUND_ENGINEER, SONGWRITER
  permissions     String        @default("CAN_RECORD") // CAN_RECORD, CAN_LISTEN_ONLY, CO_PRODUCER
  joinedAt        DateTime      @default(now())

  @@unique([collabId, userId])
}

model CollaborationInvite {
  id              String        @id @default(uuid())
  collabId        String
  collab          Collaboration @relation(fields: [collabId], references: [id], onDelete: Cascade)
  inviterId       String
  inviter         User          @relation("CollaborationInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeEmail    String?
  inviteeUsername String?
  token           String        @unique // Secure cryptographic invite token
  role            String        @default("FEATURE_ARTIST")
  permissions     String        @default("CAN_RECORD") // CAN_RECORD, CAN_LISTEN_ONLY, CO_PRODUCER
  message         String?       @db.Text
  status          String        @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CollaborationTrack {
  id              String                 @id @default(uuid())
  collabId        String
  collab          Collaboration          @relation(fields: [collabId], references: [id], onDelete: Cascade)
  uploaderId      String
  uploader        User                   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  trackName       String                 // e.g. "Guest Verse 1", "Chorus Lead"
  layerType       String                 @default("FEATURE_VOCAL")
  timelineOffset  Float                  @default(0.0) // Precise second offset in project timeline
  status          String                 @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED, REVISION_REQUESTED
  reviewNote      String?                @db.Text
  parentTrackId   String?                // Linked AudioTrack ID in master Project once approved
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  versions        CollaborationVersion[]
}

model CollaborationVersion {
  id              String             @id @default(uuid())
  collabTrackId   String
  collabTrack     CollaborationTrack @relation(fields: [collabTrackId], references: [id], onDelete: Cascade)
  versionNumber   Int                @default(1)
  assetUrl        String             // /api/audio/track/[id] or secure stream
  storageType     String             @default("POSTGRES_BYTEA") // POSTGRES_BYTEA | VERCEL_BLOB
  sampleRate      Int                @default(44100)
  bitDepth        Int                @default(16)
  channels        Int                @default(1) // 1 = mono vocal, 2 = stereo
  duration        Float              @default(0.0)
  timelineOffset  Float              @default(0.0)
  fileSize        Int                @default(0)
  audioChecksum   String             // SHA-256 integrity hash
  waveform        String?            @db.Text // JSON peaks
  notes           String?            @db.Text
  isFinal         Boolean            @default(false)
  createdAt       DateTime           @default(now())

  comments        CollaborationComment[]
}

model CollaborationComment {
  id              String                @id @default(uuid())
  collabId        String
  collab          Collaboration         @relation(fields: [collabId], references: [id], onDelete: Cascade)
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId       String?
  version         CollaborationVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  timestamp       Float?                // Timeline marker in seconds
  message         String                @db.Text
  createdAt       DateTime              @default(now())
}

model CollaborationCreditSplit {
  id              String        @id @default(uuid())
  collabId        String
  collab          Collaboration @relation(fields: [collabId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  artistName      String        // Stage name / Legal name
  role            String        // MAIN_ARTIST, FEATURED_ARTIST, PRODUCER, SONGWRITER, COMPOSER
  splitPercentage Float         // e.g. 50.0%
  confirmed       Boolean       @default(false)
  confirmedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CollaborationNotification {
  id              String        @id @default(uuid())
  collabId        String
  collab          Collaboration @relation(fields: [collabId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       User          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?         @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  type            String        // INVITE_RECEIVED, INVITE_ACCEPTED, TRACK_SUBMITTED, TRACK_APPROVED, REVISION_REQUESTED, COMMENT_ADDED
  title           String
  message         String        @db.Text
  read            Boolean       @default(false)
  link            String?       // Route link to collab or guest studio
  createdAt       DateTime      @default(now())
}



